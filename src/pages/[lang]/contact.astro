---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { langs, site, type Lang } from '../../site';
import { t } from '../../i18n/ui';
import { monthlyPackages, smePackages } from '../../i18n/packages';

export function getStaticPaths() { return langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const u = t(lang);
const c = {
  en: {
    sub: 'Tell us about your business and we will get back to you with the right solution.',
    infoTitle: 'Get in touch', infoText: 'Reach us through any of the channels below, or send us a message using the form.',
    phone: 'Phone', whatsapp: 'WhatsApp', email: 'Email', address: 'Office', instagram: 'Instagram', x: 'X (Twitter)',
    formTitle: 'Book a consultation', name: 'Full name', mobile: 'Mobile number', mail: 'Email', company: 'Company name',
    pkg: 'Package / service', pkgNone: 'Select a package or service', other: 'Other / not sure', message: 'Message', send: 'Send request',
    sent: 'Thank you! We are opening your message now.',
    notReady: 'Thank you for your interest. Our contact channels will be available very soon. Please check back shortly.',
    greeting: 'Hello Mieyar, I would like to book a consultation.',
  },
  ar: {
    sub: 'أخبرنا عن نشاطك التجاري وسنعود إليك بالحل المناسب.',
    infoTitle: 'تواصل معنا', infoText: 'يمكنك التواصل معنا عبر أي من القنوات التالية، أو إرسال رسالة من خلال النموذج.',
    phone: 'الهاتف', whatsapp: 'واتساب', email: 'البريد الإلكتروني', address: 'المكتب', instagram: 'إنستغرام', x: 'إكس (تويتر)',
    formTitle: 'احجز استشارة', name: 'الاسم الكامل', mobile: 'رقم الهاتف', mail: 'البريد الإلكتروني', company: 'اسم الشركة',
    pkg: 'الباقة / الخدمة', pkgNone: 'اختر باقة أو خدمة', other: 'أخرى / غير متأكد', message: 'الرسالة', send: 'إرسال الطلب',
    sent: 'شكراً لك! جارٍ فتح رسالتك الآن.',
    notReady: 'شكراً لاهتمامك. ستتوفر قنوات التواصل قريباً جداً، يرجى المحاولة لاحقاً.',
    greeting: 'مرحباً معيار، أرغب في حجز استشارة.',
  },
}[lang];
const items = [
  { icon: 'phone', label: c.phone, value: site.phone, link: site.phone ? `tel:${site.phone.replace(/\s/g, '')}` : '' },
  { icon: 'whatsapp', label: c.whatsapp, value: site.whatsapp ? `+${site.whatsapp}` : '', link: site.whatsapp ? `https://wa.me/${site.whatsapp}` : '' },
  { icon: 'mail', label: c.email, value: site.email, link: site.email ? `mailto:${site.email}` : '' },
  { icon: 'map', label: c.address, value: site.address[lang], link: site.address[lang] ? site.mapUrl : '' },
  { icon: 'instagram', label: c.instagram, value: site.instagram ? `@${site.instagram}` : '', link: site.instagram ? `https://instagram.com/${site.instagram}` : '' },
  { icon: 'x', label: c.x, value: site.x ? `@${site.x}` : '', link: site.x ? `https://x.com/${site.x}` : '' },
];
const options = [
  ...monthlyPackages[lang].map((p) => p.name),
  ...smePackages[lang].map((p) => p.name),
  u.nav.clinics, u.nav.inventory, u.nav.advisory,
];
---
<Base lang={lang} page="contact" title={u.nav.contact} description={c.sub}>
  <PageHero lang={lang} title={u.nav.contact} subtitle={c.sub} image="/img/about.jpg" />
  <section class="section alt">
    <div class="container contact-grid">
      <div>
        <h2>{c.infoTitle}</h2>
        <p style="color:var(--muted)">{c.infoText}</p>
        {items.map((it) => (
          <div class="contact-item">
            <div class="icon"><Icon name={it.icon} size={22} /></div>
            <div>
              <h4>{it.label}</h4>
              {it.value
                ? (it.link ? <a class="val" href={it.link} target="_blank" rel="noopener">{it.value}</a> : <span class="val">{it.value}</span>)
                : <span class="soon">{u.comingSoon}</span>}
            </div>
          </div>
        ))}
      </div>
      <div class="form-card" id="form">
        <h2 style="font-size:28px">{c.formTitle}</h2>
        <form id="contact-form" data-whatsapp={site.whatsapp} data-email={site.email} data-greeting={c.greeting}
          data-sent={c.sent} data-notready={c.notReady}
          data-labels={JSON.stringify({ name: c.name, mobile: c.mobile, mail: c.mail, company: c.company, pkg: c.pkg, message: c.message })}>
          <div class="form-row">
            <div class="field"><label for="f-name">{c.name} *</label><input id="f-name" name="name" required /></div>
            <div class="field"><label for="f-mobile">{c.mobile} *</label><input id="f-mobile" name="mobile" type="tel" required dir="ltr" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="f-mail">{c.mail}</label><input id="f-mail" name="mail" type="email" dir="ltr" /></div>
            <div class="field"><label for="f-company">{c.company}</label><input id="f-company" name="company" /></div>
          </div>
          <div class="field">
            <label for="f-pkg">{c.pkg}</label>
            <select id="f-pkg" name="pkg">
              <option value="">{c.pkgNone}</option>
              {options.map((o) => <option value={o}>{o}</option>)}
              <option value={c.other}>{c.other}</option>
            </select>
          </div>
          <div class="field"><label for="f-msg">{c.message}</label><textarea id="f-msg" name="message" rows="5"></textarea></div>
          <button class="btn btn-gold" type="submit" style="width:100%;justify-content:center">{c.send}</button>
          <div class="form-msg" id="form-msg" role="status"></div>
        </form>
      </div>
    </div>
  </section>
  {site.mapEmbedUrl && (
    <iframe src={site.mapEmbedUrl} title={c.address} style="width:100%;height:420px;border:0;display:block" loading="lazy"></iframe>
  )}
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const msg = document.getElementById('form-msg');
  if (form) {
    const pkg = new URLSearchParams(location.search).get('package');
    const select = form.elements.namedItem('pkg') as HTMLSelectElement;
    if (pkg) {
      if (![...select.options].some((o) => o.value === pkg)) select.add(new Option(pkg, pkg));
      select.value = pkg;
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = form.dataset;
      const labels = JSON.parse(d.labels || '{}');
      const data = new FormData(form);
      const lines = [d.greeting || ''];
      for (const key of ['name', 'mobile', 'mail', 'company', 'pkg', 'message']) {
        const v = String(data.get(key) || '').trim();
        if (v) lines.push(`${labels[key]}: ${v}`);
      }
      const text = lines.join('\n');
      let url = '';
      if (d.whatsapp) url = `https://wa.me/${d.whatsapp}?text=${encodeURIComponent(text)}`;
      else if (d.email) url = `mailto:${d.email}?subject=${encodeURIComponent(d.greeting || '')}&body=${encodeURIComponent(text)}`;
      if (msg) { msg.textContent = url ? d.sent || '' : d.notready || ''; msg.classList.add('show'); }
      if (url) window.open(url, '_blank');
    });
  }
</script>
