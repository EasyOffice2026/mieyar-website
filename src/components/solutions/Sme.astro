---
import Icon from '../Icon.astro';
import PackageCard from '../PackageCard.astro';
import { type Lang } from '../../site';
import { t } from '../../i18n/ui';
import { smePackages } from '../../i18n/packages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const c = {
  en: {
    sub: 'One-time financial planning packages for new projects, startups and restaurants.',
    kicker: 'Small & medium businesses', title: 'Start with the right numbers',
    text: 'Before you sign a lease or order equipment, know your costs, your prices and when you will break even. Our SME packages give founders and investors a clear, realistic financial picture.',
    why: [
      { icon: 'chart', title: 'Realistic projections', text: 'Forecasts built on local market costs, not guesses.' },
      { icon: 'food', title: 'F&B expertise', text: 'Menu costing and pricing for restaurants and cafés.' },
      { icon: 'briefcase', title: 'Investor-ready', text: 'Clear reports you can share with banks and partners.' },
    ],
    pkgTitle: 'SME packages', note: 'One-time fees in Kuwaiti Dinar. Custom scopes are available on request.',
  },
  ar: {
    sub: 'باقات تخطيط مالي لمرة واحدة للمشاريع الجديدة والناشئة والمطاعم.',
    kicker: 'المشاريع الصغيرة والمتوسطة', title: 'ابدأ بالأرقام الصحيحة',
    text: 'قبل توقيع عقد الإيجار أو طلب المعدات، اعرف تكاليفك وأسعارك ومتى تصل إلى نقطة التعادل. تمنح باقاتنا المؤسسين والمستثمرين صورة مالية واضحة وواقعية.',
    why: [
      { icon: 'chart', title: 'توقعات واقعية', text: 'تقديرات مبنية على تكاليف السوق المحلي وليس على التخمين.' },
      { icon: 'food', title: 'خبرة في المطاعم', text: 'احتساب تكلفة قوائم الطعام وتسعيرها للمطاعم والمقاهي.' },
      { icon: 'briefcase', title: 'جاهزة للمستثمرين', text: 'تقارير واضحة يمكنك مشاركتها مع البنوك والشركاء.' },
    ],
    pkgTitle: 'باقات المشاريع الصغيرة', note: 'رسوم لمرة واحدة بالدينار الكويتي. يمكن تخصيص نطاق العمل عند الطلب.',
  },
}[lang];
---
<div class="sol-block" id="sme">
  <section class="section">
    <div class="container">
      <div class="section-head reveal"><span class="kicker">{c.kicker}</span><h2>{c.title}</h2><p>{c.text}</p></div>
      <div class="grid grid-3">
        {c.why.map((w) => <div class="feature reveal"><div class="icon"><Icon name={w.icon} /></div><h3>{w.title}</h3><p>{w.text}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="container">
      <div class="section-head reveal"><h2>{c.pkgTitle}</h2></div>
      <div class="grid grid-3">{smePackages[lang].map((p) => <PackageCard lang={lang} pkg={p} />)}</div>
      <p class="note">{c.note}</p>
    </div>
  </section>
</div>
